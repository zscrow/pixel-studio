{
  "name": "pixel-studio",
  "version": "2.0.0",
  "description": "Aplicativo desktop de pixel art e animação com onion skin.",
  "author": "Andre Saulo",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check dist/app.js && node --test tests/*.test.cjs",
    "build:win": "electron-builder --win zip --x64 --publish never",
    "build:single": "electron-builder --win portable --x64 --publish never",
    "build:installer": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.zscrow.pixelstudio",
    "productName": "Pixel Studio",
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "extraFiles": [{"from": "desktop/portable-mode", "to": "portable-mode"}],
    "win": {
      "target": [
        "zip"
      ],
      "icon": "desktop/assets/icon.ico",
      "artifactName": "Pixel-Studio-${version}-Windows-Portable.${ext}",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Pixel-Studio-${version}-Windows.exe"
    },
    "nsis": {
      "artifactName": "Pixel-Studio-${version}-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pixel Studio",
      "installerLanguages": ["pt_BR", "en_US"]
    }
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  }
}
